                "10",
                "12",
                "15"
              ],
              "answer": "12"
            },
            {
              "id": "math-3",
              "prompt": "The princess has 6 diamond tiaras and gets 6 more. How many tiaras total?",
              "options": [
                "10",
                "12",
                "14",
                "16"
              ],
              "answer": "12"
            },
            {
